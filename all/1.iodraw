                       fillColor=#F2FAF3;strokeColor=#8FC79D;strokeWidth=1.6;
                       fontFamily=Microsoft YaHei;fontSize=18;fontStyle=1;
                       fontColor=#222222;verticalAlign=top;spacingTop=12;"
                vertex="1"
                parent="1">
          <mxGeometry x="70" y="85" width="1560" height="355" as="geometry"/>
        </mxCell>


        <!-- 文本模态子区域 -->

        <mxCell id="text_panel"
                value="文本模态"
