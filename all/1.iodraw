                       fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;
                       fontColor=#222222;"
                vertex="1"
                parent="1">
          <mxGeometry x="350" y="20" width="1000" height="45" as="geometry"/>
        </mxCell>


        <!-- ====================================================== -->
        <!-- 第一阶段 -->
        <!-- ====================================================== -->

        <mxCell id="stage1"
                value="第一阶段  三模态编码与可用性检测"
