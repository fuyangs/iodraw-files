                       fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;
                       fontColor=#6E4613;"
                vertex="1"
                parent="1">
          <mxGeometry x="510" y="520" width="680" height="80" as="geometry"/>
        </mxCell>


        <!-- ====================================================== -->
        <!-- 图2式分叉结构 -->
        <!-- ====================================================== -->

        <!-- 隐形节点：上方分叉 -->

        <mxCell id="branch_top_center"
                style="ellipse;fillOpacity=0;strokeOpacity=0;opacity=0;"
                vertex="1"
                parent="1">
          <mxGeometry x="849" y="625" width="2" height="2" as="geometry"/>
        </mxCell>

        <mxCell id="branch_top_left"
                style="ellipse;fillOpacity=0;strokeOpacity=0;opacity=0;"
