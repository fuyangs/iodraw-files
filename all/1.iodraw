          <mxGeometry x="70" y="465" width="1560" height="350" as="geometry"/>
        </mxCell>


        <mxCell id="dynamic_fusion"
                value="Missing-Aware Dynamic Fusion&#xa;缺失感知动态门控融合&#xa;缺失模态屏蔽 → Masked Softmax → 可用模态动态权重分配"
                style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;
