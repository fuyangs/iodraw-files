                vertex="1"
                parent="1">
          <mxGeometry x="70" y="1130" width="1560" height="280" as="geometry"/>
        </mxCell>


        <!-- 缺失增强卡片 -->

        <mxCell id="train_aug_panel"
                value="① 连续局部缺失增强"
                style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;
                       fillColor=#FFF9EE;strokeColor=#DFAE61;strokeWidth=1.4;
                       fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;
                       verticalAlign=top;spacingTop=10;"
