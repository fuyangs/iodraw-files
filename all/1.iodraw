                       fontColor=#9A5414;verticalAlign=top;spacingTop=10;"
                vertex="1"
                parent="1">
          <mxGeometry x="130" y="140" width="410" height="225" as="geometry"/>
        </mxCell>

        <mxCell id="text_input"
                value="Text 输入&#xa;text_bert（3×50）"
