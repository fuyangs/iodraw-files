                parent="1">
          <mxGeometry x="494" y="625" width="2" height="2" as="geometry"/>
        </mxCell>

        <mxCell id="branch_top_right"
                style="ellipse;fillOpacity=0;strokeOpacity=0;opacity=0;"
                vertex="1"
                parent="1">
          <mxGeometry x="1204" y="625" width="2" height="2" as="geometry"/>
        </mxCell>


        <!-- 左右条件文字 -->

        <mxCell id="available_label"
