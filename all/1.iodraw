                vertex="1"
                parent="1">
          <mxGeometry x="355" y="680" width="280" height="78" as="geometry"/>
        </mxCell>

        <mxCell id="gap_embedding"
                value="Gap Embedding&#xa;使用可学习缺口向量表示当前信息中断"
                style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;
                       fillColor=#FFF3EC;strokeColor=#D99A70;strokeWidth=1.5;
                       fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;
                       fontColor=#875537;"
                vertex="1"
                parent="1">
          <mxGeometry x="1065" y="680" width="280" height="78" as="geometry"/>
        </mxCell>


        <!-- 隐形节点：下方汇合 -->

        <mxCell id="branch_bottom_left"
                style="ellipse;fillOpacity=0;strokeOpacity=0;opacity=0;"
                vertex="1"
                parent="1">
          <mxGeometry x="494" y="783" width="2" height="2" as="geometry"/>
        </mxCell>

        <mxCell id="branch_bottom_right"
                style="ellipse;fillOpacity=0;strokeOpacity=0;opacity=0;"
