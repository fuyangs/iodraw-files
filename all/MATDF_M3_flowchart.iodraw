        <mxCell id="title" value="MATDF：缺失感知时序融合网络（最终 M3）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="目标：局部连续模态缺失下，同时完成情感极性三分类与情感强度回归" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="42" y="62" width="1000" height="28" as="geometry" />
        </mxCell>
        <mxCell id="deployment_note" value="部署 / 附件3推理：仅输入 text_bert、audio、vision；教师 text 只在训练蒸馏阶段使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#A6A6A6;fontSize=13;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1250" y="25" width="590" height="70" as="geometry" />
        </mxCell>

        <mxCell id="teacher" value="教师文本特征（训练阶段）&lt;br&gt;附件2 text：50×768" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="230" height="82" as="geometry" />
        </mxCell>
        <mxCell id="pca" value="PCA教师投影&lt;br&gt;768 → 128" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="115" width="210" height="82" as="geometry" />
        </mxCell>
        <mxCell id="teacher_target" value="z_teacher&lt;br&gt;文本蒸馏目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="115" width="220" height="82" as="geometry" />
        </mxCell>
        <mxCell id="training_badge" value="虚线框 / 虚线箭头：仅训练使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#D6B656;dashed=1;fontSize=12;fontColor=#7F6000;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="840" y="115" width="270" height="55" as="geometry" />
        </mxCell>

        <mxCell id="input_text" value="文本输入&lt;br&gt;text_bert：3×50&lt;br&gt;token / attention / segment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#5B9BD5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="255" width="235" height="105" as="geometry" />
        </mxCell>
        <mxCell id="input_audio" value="音频输入&lt;br&gt;audio：50×74" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#5B9BD5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="435" width="235" height="105" as="geometry" />
        </mxCell>
        <mxCell id="input_vision" value="视觉输入&lt;br&gt;vision：50×35" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#5B9BD5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="615" width="235" height="105" as="geometry" />
        </mxCell>

        <mxCell id="mask" value="三模态可用性掩码&lt;br&gt;a_t^m = m_t^m · s_t^m&lt;br&gt;UNK / 零行 / 人工连续遮蔽&lt;br&gt;T、A、V 逐时间步判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="390" width="245" height="170" as="geometry" />
        </mxCell>

        <mxCell id="text_encoder" value="BERT-tiny 文本编码器&lt;br&gt;可训练并接受文本蒸馏&lt;br&gt;H^T ∈ R^(50×128)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="245" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="audio_encoder" value="音频编码器&lt;br&gt;Linear投影 + LayerNorm + GELU&lt;br&gt;+ BiGRU&lt;br&gt;H^A ∈ R^(50×128)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="425" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="vision_encoder" value="视觉编码器&lt;br&gt;Linear投影 + LayerNorm + GELU&lt;br&gt;+ BiGRU&lt;br&gt;H^V ∈ R^(50×128)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="605" width="300" height="130" as="geometry" />
        </mxCell>

        <mxCell id="fusion" value="缺失感知动态门控融合&lt;br&gt;先屏蔽不可用模态，再 masked softmax&lt;br&gt;α_t^m=0（缺失模态）&lt;br&gt;F_t = Σ_m α_t^m H_t^m&lt;br&gt;全缺失位置使用 gap embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1010" y="385" width="330" height="225" as="geometry" />
        </mxCell>
        <mxCell id="temporal" value="融合时序编码器&lt;br&gt;Fusion BiGRU&lt;br&gt;利用前后文补偿局部缺失&lt;br&gt;输出 50×128 时序表示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="400" width="275" height="170" as="geometry" />
        </mxCell>
        <mxCell id="pooling" value="Masked Attention Pooling&lt;br&gt;得到样本级融合表示&lt;br&gt;z ∈ R^128" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1400" y="640" width="275" height="105" as="geometry" />
        </mxCell>

        <mxCell id="cls_head" value="分类 MLP 双头之一&lt;br&gt;3类情感极性&lt;br&gt;ŷ_cls = softmax(W_c z)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#2F75B5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1740" y="515" width="180" height="105" as="geometry" />
        </mxCell>
        <mxCell id="reg_head" value="回归 MLP 双头之二&lt;br&gt;情感强度 [-3,3]&lt;br&gt;ŷ_reg = 3 tanh(W_r z)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#548235;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1740" y="665" width="180" height="105" as="geometry" />
        </mxCell>

        <mxCell id="loss" value="训练阶段损失（推理时移除）&lt;br&gt;完整 / 缺失双前向：任务损失 = CE + Smooth-L1&lt;br&gt;一致性约束：λ_cls = 0.2，λ_reg = 0.5&lt;br&gt;文本蒸馏：L_distill = ||H^T − z_teacher||_1&lt;br&gt;最终部署：M3(0.2,0.5) + MLP分类头 + MLP回归头" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;dashed=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="850" width="960" height="145" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="实线：推理路径　　虚线：仅训练辅助路径　　蓝色：模态编码　　橙色：动态融合　　紫色：时序与池化　　双头：分类 + 回归" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontSize=12;fontColor=#595959;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="580" height="65" as="geometry" />
